--!strict
-- Packs our art into the generated data modules the game ships (src/shared/Art/*Data.luau): each image a
-- run-length coverage mask in base64. Run: lune run tools/art/pack.luau
local fs = require("@lune/fs")
local Raster = require("./raster")
local Icons = require("./icons")
local M = require("./codec")

local names = {}
for k in Icons do
	if k ~= "ALIASES" then
		table.insert(names, k)
	end
end
table.sort(names)
local SIZE = 64
local lines = {
	"-- GENERATED by tools/art/pack.luau from tools/art/icons.luau: do not edit by hand.",
	"-- Our UI glyphs: 64 x 64 white-on-transparent coverage masks, run-length + base64 (Art/Pack decodes).",
	"return {",
	"\tsize = " .. SIZE .. ",",
	"\ticons = {",
}
local total = 0
for _, name in names do
	local m = Raster.render(Icons[name], SIZE, SIZE, 64)
	local text = M.b64(M.rle(m))
	total += #text
	table.insert(lines, string.format("\t\t%s = \"%s\",", name, text))
end
table.insert(lines, "\t},")
table.insert(lines, "\taliases = {")
local aliases = {}
for k, v in Icons.ALIASES do
	table.insert(aliases, string.format("\t\t%s = \"%s\",", k, v))
end
table.sort(aliases)
for _, l in aliases do
	table.insert(lines, l)
end
table.insert(lines, "\t},")
table.insert(lines, "}")
fs.writeFile("src/shared/Art/IconData.luau", table.concat(lines, "\n") .. "\n")
print(string.format("packed %d icons, %d characters of data", #names, total))
